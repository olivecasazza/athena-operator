# mesh-llm serving image (AMD/ROCm) — for running the ephemeral mesh on traitor
# (RX 7900 XTX, gfx110X) so it stays OUT of the Kueue-managed NVIDIA hp pool.
#
# UNVALIDATED: the CUDA image (Dockerfile.mesh) is smoke-tested; this ROCm variant
# is NOT yet — there's no AMD GPU on the build host. Smoke on traitor before using
# as a campaign default: `docker run --device /dev/kfd --device /dev/dri ... serve
# --model 0.5b --listen-all --headless` then curl :9337/v1/models.
FROM rocm/dev-ubuntu-24.04:7.0-complete

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates libgomp1 && rm -rf /var/lib/apt/lists/*

ARG MESH_VER=v0.73.1
RUN curl -fsSL "https://github.com/Mesh-LLM/mesh-llm/releases/download/${MESH_VER}/mesh-llm-x86_64-unknown-linux-gnu-rocm.tar.gz" -o /tmp/m.tgz \
 && mkdir -p /opt/mesh && tar xzf /tmp/m.tgz -C /opt/mesh \
 && ln -s /opt/mesh/mesh-bundle/mesh-llm /usr/local/bin/mesh-llm \
 && rm /tmp/m.tgz

RUN mesh-llm runtime install rocm --cache-dir /opt/mesh-runtime || true
ENV MESH_LLM_NATIVE_RUNTIME_CACHE=/opt/mesh-runtime \
    HF_HOME=/data/hf

EXPOSE 9337 3131
ENTRYPOINT ["mesh-llm"]
