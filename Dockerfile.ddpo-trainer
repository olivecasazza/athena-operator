# DDPO trainer image for athena Experiments (experiments/ddpo/train_ddpo.py).
# TRL's DDPOTrainer + diffusers Stable Diffusion 1.5 (LoRA) + the
# improved-aesthetic-predictor reward. trl is pinned to the last series that
# ships DDPOTrainer (it was removed in trl 0.12+); diffusers/transformers are
# pinned to the versions that series was tested against.
FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

RUN pip install --no-cache-dir \
    "trl[diffusers]==0.11.4" \
    diffusers==0.27.2 \
    transformers==4.41.2 \
    accelerate==0.30.1 \
    safetensors>=0.4.3 \
    pillow>=10.3.0 \
    requests>=2.32.0

WORKDIR /app
COPY experiments/ /app/experiments/
# train_ddpo.py imports athena_metrics from the experiments dir.
ENV PYTHONPATH=/app/experiments

# Model weights (SD1.5, CLIP, aesthetic head) download from HF on first run;
# the RuntimeProfile sets HF_HOME to the shared workspace PVC so later trials
# reuse the cache.
CMD ["python", "experiments/ddpo/train_ddpo.py"]
