# SkyPilot launcher image for athena cloud bursts.
#
# Sky-enabled RuntimeProfiles (spec.sky) don't run the workload on-prem: the
# operator builds a small LAUNCHER Job from this image instead. The launcher
# receives an operator-rendered sky task (same container image / command / env
# the on-prem Job path would use) and runs
#   sky launch --yes --down --idle-minutes-to-autostop <n>
# under a hard `timeout` (spec.sky.ttlMinutes), followed by an unconditional
# `sky down` — a burst never leaves a zombie cloud node. The launcher Job (not
# the cloud node) is what Kueue admits, so bursts flow through quota accounting.
FROM python:3.11-slim

# bash runs the launcher script; timeout (coreutils) enforces the hard TTL;
# git/rsync/ssh are sky's file-sync + provisioning plumbing.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        gnupg \
        openssh-client \
        rsync \
    && rm -rf /var/lib/apt/lists/*

# gcloud CLI: sky's GCP provisioner shells out to it for auth and API calls.
RUN curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
        > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && apt-get update && apt-get install -y --no-install-recommends google-cloud-cli \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "skypilot[gcp]"

# Cloud credentials arrive as env vars via spec.sky.envSecretRef (envFrom on
# the launcher container); sky state lives under $HOME/.sky for the pod's life.
WORKDIR /athena
