# mesh-llm serving image (NVIDIA/CUDA) — the ephemeral inference endpoint the
# athena campaign controller brings up per run (ResearchCampaign.spec.inferenceMesh).
#
# Serves an OpenAI-compatible API on :9337. Multi-GPU auto-split verified on 2x
# Quadro RTX 5000 (Turing): `serve --model <m> --listen-all --headless`.
#
# NOTE: mesh-llm fetches a per-backend "native runtime" on first start (~10-20s).
# We best-effort pre-bake it here; if that fails at build time (no GPU during
# build), the container downloads it once on first boot — the smoke proved a cold
# start is ready in ~40s incl. model download.
FROM nvidia/cuda:12.6.2-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates libgomp1 && rm -rf /var/lib/apt/lists/*

ARG MESH_VER=v0.73.1
RUN curl -fsSL "https://github.com/Mesh-LLM/mesh-llm/releases/download/${MESH_VER}/mesh-llm-x86_64-unknown-linux-gnu-cuda-12.tar.gz" -o /tmp/m.tgz \
 && mkdir -p /opt/mesh && tar xzf /tmp/m.tgz -C /opt/mesh \
 && ln -s /opt/mesh/mesh-bundle/mesh-llm /usr/local/bin/mesh-llm \
 && rm /tmp/m.tgz

# Best-effort native-runtime pre-bake (non-fatal — falls back to first-boot fetch).
RUN mesh-llm runtime install cuda-12 --cache-dir /opt/mesh-runtime || true
ENV MESH_LLM_NATIVE_RUNTIME_CACHE=/opt/mesh-runtime \
    HF_HOME=/data/hf

EXPOSE 9337 3131
ENTRYPOINT ["mesh-llm"]
